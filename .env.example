# ── Payload / App ────────────────────────────────────────────────
# Long random string used to sign Payload's JWT auth cookies. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL the app is served from (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Database (SQLite, stored on the server's own disk) ──────────
# Payload has no official MySQL/MariaDB adapter — only Postgres, SQLite
# and MongoDB are supported (its adapters are built on Drizzle, which
# doesn't speak MySQL's dialect). SQLite is the adapter that matches
# "use cPanel's own storage, no external DB service": it's a single file
# on disk, no separate database server to provision.
#
# Use a `file:` URL pointing at a path *outside* /public (so the raw
# database file is never served over HTTP). A relative path is resolved
# from the app's working directory at runtime.
# Example: file:./data/nigeria-lex.db
#
# If your cPanel plan instead gives you a real PostgreSQL service (some
# WHM setups do, via phpPgAdmin/Postgres Selector), you can use that
# instead with zero code changes — swap the adapter back to
# @payloadcms/db-postgres in src/payload.config.ts and set this to the
# Postgres connection string. See DEPLOY_CPANEL.md.
DATABASE_URI=file:./data/nigeria-lex.db

# ── Media storage (server's own disk) ────────────────────────────
# Uploads (logos, lawyer photos, PDFs) are written to /public/media on
# the app's own filesystem — see src/collections/Media.ts — and served
# directly by Next.js as static files. No bucket, keys or endpoint to
# configure. Back up /public/media along with the database file, since
# both now live on the same disk instead of a separately-backed-up bucket.

# ── Email (Nodemailer via cPanel webmail SMTP) ───────────────────
# Transactional email for subscriber confirmations, research-submission
# confirmations, contact-form confirmations, and the internal "new
# subscriber / submission / message" staff alerts. If left blank, emails
# are skipped (logged to the console) rather than failing the request.
#
# Sends through the cPanel mailbox for nigerialex.com (info@, events@,
# research@, etc. — whichever mailbox you want outgoing mail to come
# from) instead of a third-party provider. Find the exact host/port for
# your account under https://nigerialex.com/webmail → "Configure Mail
# Client" (values below are the common cPanel defaults, but confirm them
# there — some hosts use a server hostname like server123.yourhost.com
# instead of mail.nigerialex.com).
SMTP_HOST=mail.nigerialex.com
SMTP_PORT=465
# The full sending mailbox address, e.g. info@nigerialex.com
SMTP_USER=
# That mailbox's password — the same one used to log in at
# https://nigerialex.com/webmail. Not a cPanel account password, and no
# app-password step is needed (unlike Gmail).
SMTP_PASS=
# "From" header shown on outgoing emails. Defaults to SMTP_USER if unset.
# Keep this the same mailbox as SMTP_USER, or most mail servers will
# flag/reject it as spoofing.
EMAIL_FROM="Nigeria Lex <info@nigerialex.com>"
# Staff inbox that receives new-subscriber / new-submission / new-contact
# alerts. Defaults to info@nigerialex.com in code if left blank here, but
# can be changed at any time without a code change.
EMAIL_NOTIFY_TO=info@nigerialex.com
