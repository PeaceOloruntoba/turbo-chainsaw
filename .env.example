# ── Payload / App ────────────────────────────────────────────────
# Long random string used to sign Payload's JWT auth cookies. Generate with:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL the app is served from (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Database (Supabase Postgres, direct connection) ─────────────
# Use Supabase's "Connection string" (URI) for a direct Postgres connection.
# Do NOT use the Supabase pooled/PgBouncer connection string for Payload
# migrations; use the direct connection (port 5432) or Supabase's
# session-mode pooler if you must use the pooled URL.
# Example: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URI=

# ── Media storage (S3-compatible) ───────────────────────────────
# Used by @payloadcms/storage-s3 for logos, lawyer photos, and PDF uploads.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only set S3_ENDPOINT for non-AWS S3-compatible providers (e.g. Cloudflare R2,
# Supabase Storage's S3-compatible endpoint, DigitalOcean Spaces). Leave blank
# for AWS S3 itself.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Hostname images are served from, used to allow next/image optimisation.
# e.g. your-bucket.s3.eu-west-2.amazonaws.com
NEXT_PUBLIC_MEDIA_HOSTNAME=
